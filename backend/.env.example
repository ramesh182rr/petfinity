# Petfinity backend configuration. Copy to `.env` for local development.
# Never put real credentials in this file. Hosted environments set these in
# the Render dashboard.

# local | test | development | staging | production
APP_ENV=local
LOG_LEVEL=INFO
# JSON logs are required in production
LOG_JSON=false

# --- Database (PostgreSQL via psycopg 3) -------------------------------------
# Local: Homebrew PostgreSQL 16. Hosted: Neon *pooled* connection string.
DATABASE_URL=postgresql+psycopg://localhost:5432/petfinity_dev
# Optional. Hosted: Neon *direct* (unpooled) connection string for Alembic.
DATABASE_MIGRATION_URL=
# true when DATABASE_URL goes through PgBouncer (Neon pooled endpoint)
DATABASE_PGBOUNCER=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Tests use a separate database. They are destructive to it, so never point this at real data.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/petfinity_test

# --- HTTP ----------------------------------------------------------------------
# Comma-separated browser origins (native apps don't need CORS). Empty = disabled.
CORS_ALLOW_ORIGINS=
# Interactive docs at /docs and schema at /api/v1/openapi.json
ENABLE_API_DOCS=true

# --- Authentication (decision 0007) ---------------------------------------------
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use different values per environment. Rotating JWT_SECRET signs everyone out;
# rotating OTP_PEPPER invalidates outstanding codes.
JWT_SECRET=
OTP_PEPPER=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=90
# console = MOCK sender that logs codes (local/test only; refused in staging/production)
OTP_DELIVERY=console
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_DESTINATION_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# --- Staff roles (decision 0006) ------------------------------------------------
# Comma-separated founder email(s) granted admin once on first verified sign-in.
BOOTSTRAP_ADMIN_EMAILS=
# Comma-separated company domains eligible for moderator/admin grants.
STAFF_EMAIL_DOMAINS=

# --- Media storage (decision 0008) ----------------------------------------------
# local = files under STORAGE_LOCAL_DIR, served via signed /api/v1/dev-storage URLs
#         (development only; refused in staging/production)
# r2    = Cloudflare R2. Requires all four R2_* values below (private bucket).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.local-storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional endpoint override (e.g. EU jurisdiction: https://<account>.eu.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=
MEDIA_MAX_IMAGE_BYTES=8000000
MEDIA_MAX_DOCUMENT_BYTES=10000000
MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_DOWNLOAD_URL_TTL_SECONDS=3600
MAX_PETS_PER_OWNER=30

# --- Added in later milestones (names reserved) ---------------------------------
# Phase 2 maps:       MAPS_PROVIDER=  MAPS_SERVER_API_KEY=
# Payments (mock):    PAYMENT_PROVIDER=mock
