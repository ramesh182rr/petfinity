{
  "components": {
    "schemas": {
      "Channel": {
        "enum": [
          "email",
          "phone"
        ],
        "title": "Channel",
        "type": "string"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Documented in OpenAPI so the mobile client can type error handling.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "capabilities": {
            "description": "Derived capabilities, e.g. pet_parent, moderator, admin (decision 0006)",
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "phone_verified": {
            "title": "Phone Verified",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "email_verified",
          "phone",
          "phone_verified",
          "capabilities",
          "created_at"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MeUpdate": {
        "properties": {
          "display_name": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "MeUpdate",
        "type": "object"
      },
      "OtpRequest": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "destination": {
            "description": "Email address, or mobile number (E.164 or 10-digit Indian)",
            "maxLength": 320,
            "minLength": 3,
            "title": "Destination",
            "type": "string"
          }
        },
        "required": [
          "channel",
          "destination"
        ],
        "title": "OtpRequest",
        "type": "object"
      },
      "OtpRequestResponse": {
        "properties": {
          "destination_masked": {
            "title": "Destination Masked",
            "type": "string"
          },
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "resend_after_seconds": {
            "title": "Resend After Seconds",
            "type": "integer"
          }
        },
        "required": [
          "destination_masked",
          "expires_in_seconds",
          "resend_after_seconds"
        ],
        "title": "OtpRequestResponse",
        "type": "object"
      },
      "OtpVerify": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "code": {
            "pattern": "^\\s*\\d{6}\\s*$",
            "title": "Code",
            "type": "string"
          },
          "destination": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Destination",
            "type": "string"
          }
        },
        "required": [
          "channel",
          "destination",
          "code"
        ],
        "title": "OtpVerify",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "SignInResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          },
          "is_new_user": {
            "title": "Is New User",
            "type": "boolean"
          },
          "refresh_expires_at": {
            "format": "date-time",
            "title": "Refresh Expires At",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeResponse"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "refresh_expires_at",
          "user",
          "is_new_user"
        ],
        "title": "SignInResponse",
        "type": "object"
      },
      "StaffRoleGrant": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/StaffRoleName"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "role"
        ],
        "title": "StaffRoleGrant",
        "type": "object"
      },
      "StaffRoleName": {
        "enum": [
          "admin",
          "moderator"
        ],
        "title": "StaffRoleName",
        "type": "string"
      },
      "StaffRoleResponse": {
        "properties": {
          "granted_at": {
            "format": "date-time",
            "title": "Granted At",
            "type": "string"
          },
          "granted_by_user_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Granted By User Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRoleName"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "user_id",
          "role",
          "granted_by_user_id",
          "granted_at",
          "revoked_at"
        ],
        "title": "StaffRoleResponse",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_expires_at": {
            "format": "date-time",
            "title": "Refresh Expires At",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "refresh_expires_at"
        ],
        "title": "TokenResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token from /auth/otp/verify",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
