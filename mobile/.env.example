# Petfinity mobile configuration. Copy to `.env` (or `.env.local`) for local development.
# EXPO_PUBLIC_* values are bundled INTO the app and visible to anyone, so never put secrets here.

# Base URL of the Petfinity API (without /api/v1).
#   Android emulator -> http://10.0.2.2:8000   (10.0.2.2 is the host machine)
#   iOS simulator    -> http://localhost:8000
#   Physical device  -> http://<your-computer-LAN-IP>:8000
# If unset in development, the app falls back to the emulator/simulator default above.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
