# Petfinity admin web app. VITE_* values are bundled into the site: never put secrets here.

# API base URL. Leave empty in local dev: Vite proxies /api to ADMIN_API_PROXY_TARGET.
# In hosted environments set the API origin, e.g. https://api.petfinity.example
VITE_API_URL=

# Dev proxy target (read by vite.config.ts, not bundled)
ADMIN_API_PROXY_TARGET=http://localhost:8000
