# Root ignore rules. Each app (mobile/, backend/) also carries its own
# .gitignore so it stays correct if split into a separate repository.

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Environment and secrets — only .env.example files are committed
.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Node / Expo
node_modules/
.expo/
dist/
web-build/
npm-debug.log*
# Native projects are generated by Expo prebuild (continuous native generation)
mobile/android/
mobile/ios/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Logs / temp
*.log
tmp/

# Local Claude Code settings
.claude/settings.local.json
